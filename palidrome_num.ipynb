     "text": [
      "Palindrome number\n"
     ]
    }
   ],
   "source": [
    "num=int(input(\"Enter the number:\"))\n",
    "original=num\n",
    "rev=0\n",
    "while num>0:\n",
    "    digit=num%10\n",
    "    rev=rev*10+digit\n",
    "    num//=10\n",
    "if original==rev:\n",
    "    print(\"Palindrome number\")\n",
    "else:\n",
    "    print(\"Not Palidrome number\")\n"
   ]
  },
