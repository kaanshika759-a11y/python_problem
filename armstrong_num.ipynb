   "source": [
    "num=int(input(\"Enter the number:\"))\n",
    "temp=num\n",
    "digit=len(str(num))\n",
    "sum=0\n",
    "while temp>0:\n",
    "    digits=temp%10\n",
    "    sum=sum+digits**digit\n",
    "    temp//=10\n",
    "if num==sum:\n",
    "    print(\"Armstrong number\")\n",
    "else:\n",
    "    print(\"Not Armstrong\")\n",
