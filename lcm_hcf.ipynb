   ],
   "source": [
    "a=int(input(\"Enter the number:\"))\n",
    "b=int(input(\"Enter the number:\"))\n",
    "hcf=1\n",
    "for i in range(1, min(a,b)+1):\n",
    "    if a%i==0 and b%i==0:\n",
    "        hcf=i\n",
    "lcm=(a*b)//hcf\n",
    "print(\"HCF=\",hcf)\n",
    "print(\"LCM=\",lcm)    "
   ]
  },
